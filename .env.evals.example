# LangSmith
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fi-bot-rag-evaluation
LANGSMITH_DATASET=fi-bot-rag-evaluation-dataset

# DeepEval judge model configuration.
# Default DeepEval judge configuration commonly uses OpenAI; set this only if
# you intend to use that provider. For Grok/custom judge configuration, follow
# the DeepEval custom-model integration instructions in evals/README.md.
OPENAI_API_KEY=your_openai_api_key

# Optional paths
# EVAL_DATASET_PATH=evals/datasets/evaluation_dataset.json
# EVAL_REPORT_DIR=evals/reports
